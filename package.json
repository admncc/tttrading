{
  "name": "tttrading",
  "version": "0.1.0",
  "private": true,
  "description": "Hyperliquid trading bot + desk: reads Telegram signals and executes them, with a dashboard for stats, group performance and per-group settings.",
  "type": "module",
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:server": "pnpm --filter @tttrading/server dev",
    "dev:web": "pnpm --filter @tttrading/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "start": "pnpm --filter @tttrading/server start"
  },
  "packageManager": "pnpm@9.12.0"
}
