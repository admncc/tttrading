# ---------------------------------------------------------------------------
# TT Trading Desk configuration. Copy to `.env` and fill in.
# ---------------------------------------------------------------------------

# Desk API
PORT=4000
HOST=0.0.0.0

# SQLite database file (default: ./data/tttrading.sqlite)
# DB_PATH=./data/tttrading.sqlite

# Trading environment: testnet | mainnet | paper
#   testnet  -> real orders on Hyperliquid testnet (needs HL_PRIVATE_KEY)
#   mainnet  -> real orders on Hyperliquid mainnet (needs HL_PRIVATE_KEY)
#   paper    -> no orders sent; fills simulated at live mid price
TRADING_ENV=testnet

# Seed demo groups + trades on an empty DB (set false for a clean start)
SEED_DEMO=true

# How often (ms) to reconcile open trades with the exchange (live mode only)
MONITOR_INTERVAL_MS=15000
# How often to pull mark prices for open trades (live unrealized PnL).
PRICE_TICKER_MS=300000

# --- Desk authentication ---------------------------------------------------
# Password to access the desk. Leave blank to DISABLE auth (local dev only).
DESK_PASSWORD=
# HMAC secret for session tokens. Set a long random value in production so
# tokens survive restarts; if blank a random one is generated per process.
AUTH_SECRET=
# Session lifetime in hours (default 168 = 1 week)
AUTH_TOKEN_TTL_HOURS=168

# --- Alerts (Telegram bot; separate from the reading user session) ---------
# Create a bot via @BotFather; get the chat id you want alerts in.
ALERT_TG_BOT_TOKEN=
ALERT_TG_CHAT_ID=
ALERT_ON_FILL=true
ALERT_ON_ERROR=true
ALERT_ON_BLOCKED=false
# Scheduled performance summaries to the alert chat (UTC hour).
ALERT_DAILY_REPORT=false
ALERT_WEEKLY_REPORT=false
ALERT_REPORT_HOUR=8
ALERT_REPORT_WEEKDAY=1

# --- Production web serving -------------------------------------------------
# Directory of the built desk the API should serve. Defaults to apps/web/dist.
# WEB_DIST=

# --- Self-update (the "Update" button) -------------------------------------
# Allow the desk to git-pull + rebuild. In Docker this needs the repo and the
# Docker socket mounted (see docker-compose.yml) — the socket grants host root,
# so only enable on a server you trust. docker-compose.yml sets these for you.
ALLOW_SELF_UPDATE=false
# REPO_DIR=/repo
# UPDATE_COMMAND=

# --- Hyperliquid (primary venue) -------------------------------------------
# Private key of your API/agent wallet (0x...). Leave blank to force simulation.
HL_PRIVATE_KEY=
# Main account address for reading positions (defaults to the wallet address).
HL_ACCOUNT_ADDRESS=

# --- Aster (backup venue for coins Hyperliquid doesn't list) ---------------
# Aster (asterdex.com) uses a Binance-compatible futures API. It only catches
# symbols the primary (Hyperliquid) doesn't offer. Enable it explicitly, or it
# turns on automatically when an API key is present. Without a key+secret it
# runs in market-data/simulation mode (like paper); with them it trades for real.
# Validate on the Aster testnet first (set ASTER_BASE_URL accordingly).
ASTER_ENABLED=false
ASTER_API_KEY=
ASTER_API_SECRET=
# USDⓈ-M futures REST host. Mainnet default shown; override for testnet.
ASTER_BASE_URL=https://fapi.asterdex.com
# Fallback max leverage cap (exchangeInfo doesn't report one per symbol).
ASTER_MAX_LEVERAGE=20

# --- MEXC (last backup — routing + market data + SIMULATION only) ----------
# MEXC catches coins listed on neither Hyperliquid nor Aster. Real order
# execution is NOT enabled: MEXC's contract API sizes in contracts (not coins),
# uses an entry-attached SL/TP model, and only reopened its futures API in Jan
# 2026 with no public testnet — so MEXC-only coins are tracked as simulated
# trades instead of hard-failing. Enable it to catch those symbols.
MEXC_ENABLED=false
MEXC_BASE_URL=https://contract.mexc.com
MEXC_MAX_LEVERAGE=20

# --- Telegram (https://my.telegram.org) ------------------------------------
TG_API_ID=
TG_API_HASH=
# Produced by: pnpm --filter @tttrading/server tg:login
TG_SESSION=

# --- Anthropic (LLM fallback signal parsing) -------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Let the AI periodically refine each channel's parsing instructions.
AUTO_REFINE_INSTRUCTIONS=false
AUTO_REFINE_DAYS=7
AUTO_REFINE_MIN_MESSAGES=25
