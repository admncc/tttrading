{
  "name": "@tttrading/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "tg:login": "tsx src/telegram/login.ts",
    "tg:channels": "tsx src/telegram/channels.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "smoke": "node scripts/smoke-boot.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.1",
    "@nktkas/hyperliquid": "^0.18.0",
    "@tttrading/shared": "workspace:*",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "nanoid": "^5.0.7",
    "telegram": "^2.26.6",
    "viem": "^2.21.45",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
